.unity-button {
    border-left-color: rgba(192, 159, 159, 0);
    border-right-color: rgba(192, 159, 159, 0);
    border-top-color: rgba(192, 159, 159, 0);
    border-bottom-color: rgba(192, 159, 159, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    transition-duration: 0.1s;
    -unity-font-definition: url("project://database/Assets/UI%20Documents/Font/UncialAntiqua-Regular.ttf?fileID=12800000&guid=78a6e963ec4b8994a9f72d5df32c963a&type=3#UncialAntiqua-Regular");
    -unity-text-outline-width: 3px;
}

.unity-button:hover {
    scale: 1.1 1.1;
    translate: 0 -7px;
    rotate: 2deg;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.unity-label {
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/UI%20Documents/Font/UncialAntiqua-Regular.ttf?fileID=12800000&guid=78a6e963ec4b8994a9f72d5df32c963a&type=3#UncialAntiqua-Regular");
    font-size: 68px;
    color: rgb(255, 255, 255);
}

.unity-labelControl {
    font-size: 60px;
    opacity: 1;
    display: flex;
}
