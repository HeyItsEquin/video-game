<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Documents/Stylesheets/OptionsMenu.uss?fileID=7433441132597879392&amp;guid=4fc58995c7994c764b2ee38fca8a99ad&amp;type=3#OptionsMenu" />
    <ui:VisualElement name="Root" style="flex-grow: 1; background-color: rgb(17, 17, 17);">
        <ui:VisualElement name="MainContent" style="flex-grow: 1; align-self: center;">
            <ui:VisualElement name="CategoriesHeader" style="margin-top: 96px; flex-direction: row;">
                <ui:Button name="NavButtonLeft" class="nav-button" style="background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=-1008301579157283121&amp;guid=b91b37539974bc142a2801960ac051b6&amp;type=3#arrow-left@2x&quot;);" />
                <ui:VisualElement name="ButtonRow" style="flex-grow: 1; width: 1150px;">
                    <ui:Button text="Gameplay" name="GameplayOptions" class="option-category active" />
                    <ui:Button text="Video" name="VideoOptions" class="option-category" />
                    <ui:Button text="Controls" name="ControlOptions" class="option-category" />
                    <ui:Button text="Audio" name="AudioOptions" class="option-category" />
                    <ui:Button text="Misc" name="MiscOptions" class="option-category" />
                </ui:VisualElement>
                <ui:Button name="NavButtonRight" class="nav-button" style="background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=-1087164816274819069&amp;guid=b91b37539974bc142a2801960ac051b6&amp;type=3#arrow-right@2x&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement name="OptionsPresenter" style="flex-grow: 1; height: auto; max-height: 700px; margin-top: 24px; padding-bottom: 48px; padding-top: 64px; padding-right: 48px; padding-left: 48px; background-color: rgb(50, 50, 50);">
                <ui:ScrollView name="OptionsContainer" style="flex-grow: 1;">
                    <ui:VisualElement name="OptionNames" style="flex-grow: 1;" />
                    <ui:VisualElement name="OptionControllers" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="BottomButtons" style="flex-grow: 0; align-content: flex-end; flex-direction: row; justify-content: flex-end; padding-top: 8px;">
                <ui:Button text="Cancel" name="CancelButton" class="action-button" />
                <ui:Button text="Reset" name="ResetButton" enable-rich-text="true" class="action-button" />
                <ui:Button text="Apply" name="ApplyButton" class="action-button" style="align-self: flex-end;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
