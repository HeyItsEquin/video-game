<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ControlElement" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-direction: row;">
        <ui:Label text="Space:" name="Button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 86px; color: rgb(255, 255, 255); -unity-text-align: upper-left; min-width: 50px; flex-basis: 50%;" />
        <ui:Label text="Jump" name="Action" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 86px; color: rgb(255, 255, 255); -unity-text-align: upper-right; min-width: 50px; flex-basis: 50%;" />
    </ui:VisualElement>
</ui:UXML>
