        <ui:VisualElement name="Buttons" style="flex-grow: 1; border-right-width: 1095px; border-top-width: 21px; border-left-width: 116px; border-bottom-width: 21px; flex-direction: row; justify-content: flex-start; align-items: auto; align-self: center; align-content: auto; width: 100%;">
